{
  "manifest_version": 3,
  "name": "Google Chrome Remote Desktop Frame Color",
  "version": "1.2.0",
  "description": "Sets the window frame (title bar) and launch splash color for the Google Chrome Remote Desktop Web App.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://remotedesktop.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Chrome Remote Desktop Frame Color",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://remotedesktop.google.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
