{
  "manifest_version": 3,
  "name": "Title Bar Theme for Chrome Remote Desktop",
  "version": "1.3.1",
  "description": "Automatically synchronizes the window frame (title bar) and launch splash color with the Google Chrome Remote Desktop Web App.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://remotedesktop.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://remotedesktop.google.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
